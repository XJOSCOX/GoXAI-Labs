# API
PORT=4000

# Supabase
# Fill these from your Supabase project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection string from Supabase.
DATABASE_URL=

# Optional direct database URL for Prisma migrations, if you keep DATABASE_URL pointed at a pooler.
# DIRECT_URL=

# Cloudflare R2
# Fill these from your Cloudflare account and R2 bucket settings.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional. Defaults can be derived later from R2_ACCOUNT_ID.
R2_ENDPOINT=

# Wallet payment providers
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
API_JSON_BODY_LIMIT=1mb
WEBHOOK_BODY_LIMIT=256kb
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=60
BILLING_RATE_LIMIT_PER_MINUTE=180
ADMIN_RATE_LIMIT_PER_MINUTE=120

# PayPal Checkout
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional comma list. Default is card. Add us_bank_account only after Stripe enables ACH for the account.
STRIPE_CHECKOUT_PAYMENT_METHODS=card

# Plaid Link for ACH readiness / Stripe bank token creation
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

