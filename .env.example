# API
PORT=4000

# Supabase
# Fill these from your Supabase project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection string from Supabase.
DATABASE_URL=

# Optional direct database URL for Prisma migrations, if you keep DATABASE_URL pointed at a pooler.
# DIRECT_URL=

# Cloudflare R2
# Fill these from your Cloudflare account and R2 bucket settings.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional. Defaults can be derived later from R2_ACCOUNT_ID.
R2_ENDPOINT=
