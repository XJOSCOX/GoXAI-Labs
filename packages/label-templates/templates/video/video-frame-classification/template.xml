<View>
  <Header value="Classify marked frame ranges."/>

  <Video name="video" value="$video"/>

  <Labels name="frame_label" toName="video" choice="multiple">
      <Label value="Start" background="#FF3B30"/>
      <Label value="Middle" background="#2563EB"/>
      <Label value="End" background="#22C55E"/>
      <Label value="Scene Change" background="#F59E0B"/>
  </Labels>

  <Choices name="frame_quality" toName="video" choice="single" showInline="true" perRegion="true">
      <Choice value="Useful"/>
      <Choice value="Duplicate"/>
      <Choice value="Low Quality"/>
  </Choices>
</View>
