<View>
  <Header value="Mark scene and event ranges in the video."/>

  <Video name="video" value="$video"/>

  <Labels name="segments" toName="video" choice="multiple">
      <Label value="Scene" background="#FF3B30"/>
      <Label value="Action" background="#2563EB"/>
      <Label value="Transition" background="#22C55E"/>
      <Label value="Other" background="#F59E0B"/>
  </Labels>

  <TextArea name="segment_note" toName="video" rows="3" editable="true" perRegion="true"/>
</View>
