<View>
  <Header value="Track objects across frames."/>

  <Video name="video" value="$video" frameRate="25.0"/>

  <VideoRectangle name="box" toName="video"/>

  <Labels name="videoLabels" toName="video" allowEmpty="true">
      <Label value="Vehicle" background="#FF3B30"/>
      <Label value="Person" background="#2563EB"/>
      <Label value="Object" background="#22C55E"/>
      <Label value="Occluded" background="#F59E0B"/>
  </Labels>

  <TextArea name="track_note" toName="video" rows="3" editable="true" perRegion="true"/>
</View>
