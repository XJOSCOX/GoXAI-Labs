<View>
  <Header value="Label activities from sensor or movement signals."/>

  <TimeSeries name="series" value="$series" valueType="url"/>

  <TimeSeriesLabels name="range" toName="series" strokeWidth="1">
      <Label value="Walking" background="#FF3B30"/>
      <Label value="Running" background="#2563EB"/>
      <Label value="Idle" background="#22C55E"/>
      <Label value="Transition" background="#F59E0B"/>
  </TimeSeriesLabels>

  <TextArea name="note" toName="series" rows="4" editable="true" perRegion="true"/>
</View>
