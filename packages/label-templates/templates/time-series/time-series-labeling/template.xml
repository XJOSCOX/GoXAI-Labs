<View>
  <Header value="Mark events and ranges in time series signals."/>

  <TimeSeries name="series" value="$series" valueType="url"/>

  <TimeSeriesLabels name="range" toName="series" strokeWidth="1">
      <Label value="Spike" background="#FF3B30"/>
      <Label value="Drop" background="#2563EB"/>
      <Label value="Stable" background="#22C55E"/>
      <Label value="Event" background="#F59E0B"/>
  </TimeSeriesLabels>

  <TextArea name="note" toName="series" rows="4" editable="true" perRegion="true"/>
</View>
