<View>
  <Header value="Find outliers and anomalous signal ranges."/>

  <TimeSeries name="series" value="$series" valueType="url"/>

  <TimeSeriesLabels name="range" toName="series" strokeWidth="1">
      <Label value="Outlier" background="#FF3B30"/>
      <Label value="Anomaly" background="#2563EB"/>
      <Label value="Normal" background="#22C55E"/>
      <Label value="Review" background="#F59E0B"/>
  </TimeSeriesLabels>

  <TextArea name="note" toName="series" rows="4" editable="true" perRegion="true"/>
</View>
