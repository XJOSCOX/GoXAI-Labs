<View>
  <Header value="Assess signal quality, missing data, and unreliable regions."/>

  <TimeSeries name="series" value="$series" valueType="url"/>

  <TimeSeriesLabels name="range" toName="series" strokeWidth="1">
      <Label value="Good" background="#FF3B30"/>
      <Label value="Missing" background="#2563EB"/>
      <Label value="Noisy" background="#22C55E"/>
      <Label value="Artifact" background="#F59E0B"/>
  </TimeSeriesLabels>

  <TextArea name="note" toName="series" rows="4" editable="true" perRegion="true"/>
</View>
