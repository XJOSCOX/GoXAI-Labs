<View>
  <Header value="Classify the rendered HTML page."/>

  <HyperText name="document" value="$document"/>

  <Choices name="classification" toName="document" choice="single">
      <Choice value="Landing Page"/>
      <Choice value="Article"/>
      <Choice value="Product Page"/>
      <Choice value="Checkout"/>
  </Choices>

  <Rating name="page_quality" toName="document" maxRating="5"/>

  <TextArea name="metadata" toName="document" rows="6" editable="true"/>
</View>
