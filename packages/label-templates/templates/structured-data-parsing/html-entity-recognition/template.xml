<View>
  <Header value="Highlight entities in rendered HTML."/>

  <HyperText name="document" value="$document"/>

  <HyperTextLabels name="entity" toName="document" granularity="word">
      <Label value="Product" background="#FF3B30"/>
      <Label value="Price" background="#2563EB"/>
      <Label value="Address" background="#22C55E"/>
      <Label value="Date" background="#F59E0B"/>
  </HyperTextLabels>

  <TextArea name="metadata" toName="document" rows="6" editable="true"/>

  <Relations name="relations" toName="document">
    <Relation value="related_to"/>
    <Relation value="part_of"/>
  </Relations>
</View>
