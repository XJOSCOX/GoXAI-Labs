<View>
  <Header value="Rate a website or page for quality and relevance."/>

  <Text name="text" value="$text"/>

  <Ranker name="ranking" toName="text" rankingMode="drag"/>

  <Rating name="score" toName="text" maxRating="10"/>

  <Choices name="decision" toName="text" choice="single">
      <Choice value="Excellent"/>
      <Choice value="Good"/>
      <Choice value="Poor"/>
      <Choice value="Unsafe"/>
  </Choices>

  <TextArea name="rationale" toName="text" rows="4" editable="true"/>
</View>
