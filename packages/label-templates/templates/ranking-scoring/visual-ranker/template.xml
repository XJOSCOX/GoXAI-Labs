<View>
  <Header value="Rank images by relevance or visual quality."/>

  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>

  <Ranker name="ranking" toName="image" rankingMode="drag"/>

  <Choices name="decision" toName="image" choice="single">
      <Choice value="Best"/>
      <Choice value="Good"/>
      <Choice value="Poor"/>
      <Choice value="Reject"/>
  </Choices>

  <TextArea name="rationale" toName="image" rows="4" editable="true"/>
</View>
