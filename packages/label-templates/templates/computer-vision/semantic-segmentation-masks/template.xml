<View>
  <Header value="Paint masks for dense semantic segmentation."/>

  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>

  <BrushLabels name="mask" toName="image" opacity="0.35">
      <Label value="Foreground" background="#FF3B30"/>
      <Label value="Background" background="#2563EB"/>
      <Label value="Defect" background="#22C55E"/>
  </BrushLabels>

  <MagicWand name="assist" toName="image" threshold="22"/>
</View>
