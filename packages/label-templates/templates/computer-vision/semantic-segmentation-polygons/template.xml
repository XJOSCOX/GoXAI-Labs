<View>
  <Header value="Draw precise object boundaries with thin polygon edges."/>

  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>

  <PolygonLabels name="label" toName="image" strokeWidth="1" pointSize="small" opacity="0.45">
      <Label value="Road" background="#FF3B30"/>
      <Label value="Building" background="#2563EB"/>
      <Label value="Sidewalk" background="#22C55E"/>
  </PolygonLabels>

  <TextArea name="region_note" toName="image" rows="4" editable="true" perRegion="true"/>
</View>
