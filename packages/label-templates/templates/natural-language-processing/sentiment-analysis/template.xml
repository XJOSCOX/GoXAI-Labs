<View>
  <Header value="Classify sentiment in reviews, messages, or documents."/>

  <Text name="text" value="$text"/>

  <Choices name="classification" toName="text" choice="single">
      <Choice value="Positive"/>
      <Choice value="Neutral"/>
      <Choice value="Negative"/>
      <Choice value="Mixed"/>
  </Choices>

  <TextArea name="response" toName="text" rows="6" editable="true"/>
</View>
