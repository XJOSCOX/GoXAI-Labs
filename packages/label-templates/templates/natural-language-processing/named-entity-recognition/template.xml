<View>
  <Header value="Highlight text spans and capture structured labels."/>

  <Text name="text" value="$text"/>

  <Labels name="label" toName="text" granularity="word">
      <Label value="Person" background="#FF3B30"/>
      <Label value="Organization" background="#2563EB"/>
      <Label value="Location" background="#22C55E"/>
      <Label value="Date" background="#F59E0B"/>
  </Labels>

  <TextArea name="note" toName="text" rows="4" editable="true" perRegion="true"/>
</View>
