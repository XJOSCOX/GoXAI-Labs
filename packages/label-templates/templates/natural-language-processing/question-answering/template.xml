<View>
  <Header value="Answer questions from supplied context passages."/>

  <Text name="text" value="$text"/>

  <Text name="question" value="$question"/>

  <Choices name="classification" toName="text" choice="single">
      <Choice value="Answer"/>
      <Choice value="Evidence"/>
      <Choice value="No Answer"/>
  </Choices>

  <TextArea name="response" toName="text" rows="6" editable="true"/>
</View>
