<View>
  <Header value="Create concise summaries and key points for long passages."/>

  <Text name="text" value="$text"/>

  <Choices name="classification" toName="text" choice="single">
      <Choice value="Summary"/>
      <Choice value="Key Point"/>
      <Choice value="Omit"/>
  </Choices>

  <TextArea name="response" toName="text" rows="6" editable="true"/>

  <Rating name="quality" toName="text" maxRating="5"/>
</View>
